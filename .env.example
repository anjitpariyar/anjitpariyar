# Copy to .env.local (local) and add the same keys in your host's settings (production).
# Only NEXT_PUBLIC_* values reach the browser. Everything else stays on the server.

# --- Existing ---------------------------------------------------------------
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
NEXT_PUBLIC_SITE_URL=https://www.anjitpariyar.com.np

# --- /chat AI assistant (server-only) ---------------------------------------
# Google AI Studio API key. Without it, /chat answers with the rule-based fallback.
GEMINI_API_KEY=
# Any current Gemini text model. Default: gemini-3.5-flash-lite
GEMINI_MODEL=
# Optional, for models that support it: MINIMAL | LOW | MEDIUM | HIGH
GEMINI_THINKING_LEVEL=

# --- Optional tuning (defaults shown) ---------------------------------------
# auto: full portfolio in the prompt while it fits, else catalog + tools
# CHAT_CONTEXT_MODE=auto            # auto | full | overview
# CHAT_FULL_CONTEXT_MAX_CHARS=40000
# CHAT_MAX_TOOL_ROUNDS=3
# GEMINI_TIMEOUT_MS=20000
# GEMINI_MAX_OUTPUT_TOKENS=1500
# CHAT_RATE_LIMIT_PER_MINUTE=10
# CHAT_RATE_LIMIT_PER_HOUR=60
